{
  "name": "flutter-easy-arch",
  "publisher": "flutter-clean-architecture",
  "displayName": "Flutter EA Toolkit: Arch & Snippets",
  "description": "The ultimate enterprise-level Flutter toolkit for generating Clean Architecture, MVVM boilerplates, and smart Dart snippets out of the box.",
  "version": "0.0.3",
  "icon": "logo.png",
  "pricing": "Free",
  "galleryBanner": {
    "color": "#00B4AB",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "Snippets",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "flutter",
    "dart",
    "clean architecture",
    "mvvm",
    "bloc",
    "riverpod",
    "getx",
    "snippets",
    "generator",
    "ea toolkit"
  ],
  "author": {
    "name": "Emad Younis",
    "email": "emadeadev@gmail.com",
    "url": "https://www.linkedin.com/in/emadpro"
  },
  "badges": [
    {
      "url": "https://img.shields.io/badge/Flutter-Architecture-02569B.svg?logo=flutter&style=for-the-badge",
      "description": "Flutter Architecture Support",
      "href": "https://marketplace.visualstudio.com/items?itemName=flutter-clean-architecture.flutter-easy-arch"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Emad-Pro/flutter-clean-architecture"
  },
  "bugs": {
    "url": "https://github.com/Emad-Pro/flutter-clean-architecture/issues"
  },
  "homepage": "https://github.com/Emad-Pro/flutter-clean-architecture#readme",
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "snippets": [
      {
        "language": "dart",
        "path": "./snippets/dart.json"
      }
    ],
    "commands": [
      {
        "command": "flutter-clean-architecture.generateFeature",
        "title": "Flutter EA: Generate Architecture Feature"
      },
      {
        "command": "flutter-clean-architecture.initCore",
        "title": "Flutter EA: Init Core Architecture (From Scratch)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "flutter-clean-architecture.generateFeature",
          "group": "navigation@1"
        },
        {
          "command": "flutter-clean-architecture.initCore",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "Flutter EA Toolkit Settings",
      "properties": {
        "flutterCleanArchitecture.defaultArchitecture": {
          "type": "string",
          "enum": [
            "Ask me every time",
            "Clean Architecture",
            "MVVM",
            "MVC",
            "MVP"
          ],
          "default": "Ask me every time",
          "description": "Select the default architectural pattern. If you choose 'Ask me every time', the EA Toolkit will prompt you during generation."
        },
        "flutterCleanArchitecture.defaultStateManagement": {
          "type": "string",
          "enum": [
            "Ask me every time",
            "bloc",
            "cubit",
            "riverpod",
            "getx",
            "provider",
            "none"
          ],
          "default": "Ask me every time",
          "description": "Select the default state management. The EA Toolkit will automatically generate the related files and install the required packages."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.110.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}