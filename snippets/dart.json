    "EA Data Repository Impl": {
        "prefix": "ea-repo-impl",
        "body": [
            "import 'package:dartz/dartz.dart';",
            "import '../../core/errors/failures.dart';",
            "import '../../core/errors/exceptions.dart';",
            "import '../../domain/repositories/${2:feature_name}_repository.dart';",
            "import '../../domain/entities/${2:feature_name}_entity.dart';",
            "import '../datasources/${2:feature_name}_remote_data_source.dart';",
            "",
            "class ${1:FeatureName}RepositoryImpl implements ${1:FeatureName}Repository {",
            "  final ${1:FeatureName}RemoteDataSource remoteDataSource;",
            "",
            "  ${1:FeatureName}RepositoryImpl(this.remoteDataSource);",
            "",
            "  @override",
            "  Future<Either<Failure, ${1:FeatureName}Entity>> get${1:FeatureName}() async {",
            "    try {",
            "      final remoteData = await remoteDataSource.fetch${1:FeatureName}();",
            "      return Right(remoteData);",
            "    } on ServerException {",
            "      return Left(ServerFailure('Server Error Occurred'));",
            "    }",
            "  }",
            "}"
        ],
        "description": "EA: Generate a Data Repository Implementation"
    },
