{
    "EA Domain Entity": {
        "prefix": "ea-entity",
        "body": [
            "import 'package:equatable/equatable.dart';",
            "",
            "class ${1:FeatureName}Entity extends Equatable {",
            "  final String id;",
            "",
            "  const ${1:FeatureName}Entity({required this.id});",
            "",
            "  @override",
            "  List<Object?> get props => [id];",
            "}"
        ],
        "description": "EA: Generate a Clean Architecture Domain Entity"
    },
    "EA Domain UseCase (No Params)": {
        "prefix": "ea-usecase",
        "body": [
            "import 'package:dartz/dartz.dart';",
            "import '../../core/errors/failures.dart';",
            "import '../repositories/${2:feature_name}_repository.dart';",
            "import '../entities/${2:feature_name}_entity.dart';",
            "",
            "class ${1:Action}${3:FeatureName}UseCase {",
            "  final ${3:FeatureName}Repository repository;",
            "",
            "  ${1:Action}${3:FeatureName}UseCase(this.repository);",
            "",
            "  Future<Either<Failure, ${3:FeatureName}Entity>> execute() async {",
            "    return await repository.${4:methodName}();",
            "  }",
            "}"
        ],
        "description": "EA: Generate a UseCase without parameters"
    },
    "EA Domain UseCase (With Params)": {
        "prefix": "ea-usecase-params",
        "body": [
            "import 'package:dartz/dartz.dart';",
            "import '../../core/errors/failures.dart';",
            "import '../repositories/${2:feature_name}_repository.dart';",
            "import '../entities/${2:feature_name}_entity.dart';",
            "",
            "class ${1:Action}${3:FeatureName}UseCase {",
            "  final ${3:FeatureName}Repository repository;",
            "",
            "  ${1:Action}${3:FeatureName}UseCase(this.repository);",
            "",
            "  Future<Either<Failure, ${3:FeatureName}Entity>> execute(${4:Params} params) async {",
            "    return await repository.${5:methodName}(params);",
            "  }",
            "}",
            "",
            "class ${4:Params} {",
            "  final String data;",
            "  ${4:Params}({required this.data});",
            "}"
        ],
        "description": "EA: Generate a UseCase with parameters"
    },
