    "EA Bloc Class": {
        "prefix": "ea-bloc",
        "body": [
            "import 'package:flutter_bloc/flutter_bloc.dart';",
            "import '${2:feature_name}_event.dart';",
            "import '${2:feature_name}_state.dart';",
            "import '../../domain/usecases/get_${2:feature_name}_usecase.dart';",
            "",
            "class ${1:FeatureName}Bloc extends Bloc<${1:FeatureName}Event, ${1:FeatureName}State> {",
            "  final Get${1:FeatureName}UseCase get${1:FeatureName}UseCase;",
            "",
            "  ${1:FeatureName}Bloc(this.get${1:FeatureName}UseCase) : super(${1:FeatureName}Initial()) {",
            "    on<Load${1:FeatureName}Event>(_onLoad${1:FeatureName});",
            "  }",
            "",
            "  Future<void> _onLoad${1:FeatureName}(Load${1:FeatureName}Event event, Emitter<${1:FeatureName}State> emit) async {",
            "    emit(${1:FeatureName}Loading());",
            "    final result = await get${1:FeatureName}UseCase.execute();",
            "    result.fold(",
            "      (failure) => emit(${1:FeatureName}Error(failure.message)),",
            "      (data) => emit(${1:FeatureName}Loaded(data)),",
            "    );",
            "  }",
            "}"
        ],
        "description": "EA: Generate a standard Bloc class with UseCase injection"
    },
    "EA Bloc Event": {
        "prefix": "ea-bloc-event",
        "body": [
            "import 'package:equatable/equatable.dart';",
            "",
            "abstract class ${1:FeatureName}Event extends Equatable {",
            "  const ${1:FeatureName}Event();",
            "",
            "  @override",
            "  List<Object> get props => [];",
            "}",
            "",
            "class Load${1:FeatureName}Event extends ${1:FeatureName}Event {}"
        ],
        "description": "EA: Generate Bloc Events"
    },
    "EA Bloc State": {
        "prefix": "ea-bloc-state",
        "body": [
            "import 'package:equatable/equatable.dart';",
            "import '../../domain/entities/${2:feature_name}_entity.dart';",
            "",
            "abstract class ${1:FeatureName}State extends Equatable {",
            "  const ${1:FeatureName}State();",
            "",
            "  @override",
            "  List<Object> get props => [];",
            "}",
            "",
            "class ${1:FeatureName}Initial extends ${1:FeatureName}State {}",
            "",
            "class ${1:FeatureName}Loading extends ${1:FeatureName}State {}",
            "",
            "class ${1:FeatureName}Loaded extends ${1:FeatureName}State {",
            "  final ${1:FeatureName}Entity data;",
            "  const ${1:FeatureName}Loaded(this.data);",
            "",
            "  @override",
            "  List<Object> get props => [data];",
            "}",
            "",
            "class ${1:FeatureName}Error extends ${1:FeatureName}State {",
            "  final String message;",
            "  const ${1:FeatureName}Error(this.message);",
            "",
            "  @override",
            "  List<Object> get props => [message];",
            "}"
        ],
        "description": "EA: Generate Bloc States with Equatable"
    },
    "EA Cubit Class": {
        "prefix": "ea-cubit",
        "body": [
            "import 'package:flutter_bloc/flutter_bloc.dart';",
            "import '${2:feature_name}_state.dart';",
            "import '../../domain/usecases/get_${2:feature_name}_usecase.dart';",
            "",
            "class ${1:FeatureName}Cubit extends Cubit<${1:FeatureName}State> {",
            "  final Get${1:FeatureName}UseCase get${1:FeatureName}UseCase;",
            "",
            "  ${1:FeatureName}Cubit(this.get${1:FeatureName}UseCase) : super(${1:FeatureName}Initial());",
            "",
            "  Future<void> fetch() async {",
            "    emit(${1:FeatureName}Loading());",
            "    final result = await get${1:FeatureName}UseCase.execute();",
            "    result.fold(",
            "      (failure) => emit(${1:FeatureName}Error(failure.message)),",
            "      (data) => emit(${1:FeatureName}Loaded(data)),",
            "    );",
            "  }",
            "}"
        ],
        "description": "EA: Generate a Cubit class"
    },
    "EA GetX Controller": {
        "prefix": "ea-getx",
        "body": [
            "import 'package:get/get.dart';",
            "import '../../domain/usecases/get_${2:feature_name}_usecase.dart';",
            "",
            "class ${1:FeatureName}Controller extends GetxController {",
            "  final Get${1:FeatureName}UseCase get${1:FeatureName}UseCase;",
            "  ",
            "  var isLoading = false.obs;",
            "  var errorMessage = ''.obs;",
            "  // var data = ${1:FeatureName}Entity().obs;",
            "",
            "  ${1:FeatureName}Controller(this.get${1:FeatureName}UseCase);",
            "",
            "  @override",
            "  void onInit() {",
            "    super.onInit();",
            "    loadData();",
            "  }",
            "",
            "  Future<void> loadData() async {",
            "    isLoading.value = true;",
            "    final result = await get${1:FeatureName}UseCase.execute();",
            "    result.fold(",
            "      (failure) => errorMessage.value = failure.message,",
            "      (resultData) {",
            "         // data.value = resultData;",
            "      },",
            "    );",
            "    isLoading.value = false;",
            "  }",
            "}"
        ],
        "description": "EA: Generate a GetX Controller"
    },
    "EA Riverpod Notifier": {
        "prefix": "ea-riverpod",
        "body": [
            "import 'package:flutter_riverpod/flutter_riverpod.dart';",
            "import '../../domain/usecases/get_${2:feature_name}_usecase.dart';",
            "",
            "final ${3:featureName}Provider = StateNotifierProvider<${1:FeatureName}Notifier, AsyncValue<dynamic>>((ref) {",
            "  // Inject UseCase here",
            "  return ${1:FeatureName}Notifier(ref.watch(get${1:FeatureName}UseCaseProvider));",
            "});",
            "",
            "class ${1:FeatureName}Notifier extends StateNotifier<AsyncValue<dynamic>> {",
            "  final Get${1:FeatureName}UseCase useCase;",
            "",
            "  ${1:FeatureName}Notifier(this.useCase) : super(const AsyncLoading()) {",
            "    load();",
            "  }",
            "",
            "  Future<void> load() async {",
            "    state = const AsyncLoading();",
            "    final result = await useCase.execute();",
            "    result.fold(",
            "      (failure) => state = AsyncError(failure.message, StackTrace.current),",
            "      (data) => state = AsyncData(data),",
            "    );",
            "  }",
            "}"
        ],
        "description": "EA: Generate a Riverpod StateNotifier"
    },
    "EA Provider (ChangeNotifier)": {
        "prefix": "ea-provider",
        "body": [
            "import 'package:flutter/material.dart';",
            "import '../../domain/usecases/get_${2:feature_name}_usecase.dart';",
            "",
            "class ${1:FeatureName}Provider extends ChangeNotifier {",
            "  final Get${1:FeatureName}UseCase useCase;",
            "",
            "  bool isLoading = false;",
            "  String? errorMessage;",
            "",
            "  ${1:FeatureName}Provider(this.useCase);",
            "",
            "  Future<void> loadData() async {",
            "    isLoading = true;",
            "    errorMessage = null;",
            "    notifyListeners();",
            "",
            "    final result = await useCase.execute();",
            "    result.fold(",
            "      (failure) => errorMessage = failure.message,",
            "      (data) {",
            "        // Assign data",
            "      },",
            "    );",
            "",
            "    isLoading = false;",
            "    notifyListeners();",
            "  }",
            "}"
        ],
        "description": "EA: Generate a Provider ChangeNotifier"
    },
    "EA Failure Class": {
        "prefix": "ea-failure",
        "body": [
            "import 'package:equatable/equatable.dart';",
            "",
            "abstract class Failure extends Equatable {",
            "  final String message;",
            "  const Failure(this.message);",
            "",
            "  @override",
            "  List<Object> get props => [message];",
            "}",
            "",
            "class ServerFailure extends Failure {",
            "  const ServerFailure(super.message);",
            "}",
            "",
            "class CacheFailure extends Failure {",
            "  const CacheFailure(super.message);",
            "}"
        ],
        "description": "EA: Generate Core Failure Classes"
    },
    "EA GetIt Injection Locator": {
        "prefix": "ea-sl",
        "body": [
            "import 'package:get_it/get_it.dart';",
            "",
            "final sl = GetIt.instance;",
            "",
            "void init${1:FeatureName}() {",
            "  // Bloc / Controller",
            "  sl.registerFactory(() => ${1:FeatureName}Bloc(sl()));",
            "",
            "  // UseCases",
            "  sl.registerLazySingleton(() => Get${1:FeatureName}UseCase(sl()));",
            "",
            "  // Repositories",
            "  sl.registerLazySingleton<${1:FeatureName}Repository>(() => ${1:FeatureName}RepositoryImpl(sl()));",
            "",
            "  // Data Sources",
            "  sl.registerLazySingleton<${1:FeatureName}RemoteDataSource>(() => ${1:FeatureName}RemoteDataSourceImpl());",
            "}"
        ],
        "description": "EA: Generate GetIt Dependency Injection Setup"
    },
    "EA BlocBuilder Page UI": {
        "prefix": "ea-page-bloc",
        "body": [
            "import 'package:flutter/material.dart';",
            "import 'package:flutter_bloc/flutter_bloc.dart';",
            "import '../manager/${2:feature_name}_bloc.dart';",
            "import '../manager/${2:feature_name}_state.dart';",
            "",
            "class ${1:FeatureName}Page extends StatelessWidget {",
            "  const ${1:FeatureName}Page({super.key});",
            "",
            "  @override",
            "  Widget build(BuildContext context) {",
            "    return Scaffold(",
            "      appBar: AppBar(title: const Text('${1:FeatureName}')),",
            "      body: BlocBuilder<${1:FeatureName}Bloc, ${1:FeatureName}State>(",
            "        builder: (context, state) {",
            "          if (state is ${1:FeatureName}Loading) {",
            "            return const Center(child: CircularProgressIndicator());",
            "          } else if (state is ${1:FeatureName}Error) {",
            "            return Center(child: Text(state.message));",
            "          } else if (state is ${1:FeatureName}Loaded) {",
            "            return Center(child: Text('Loaded Successfully'));",
            "          }",
            "          return const SizedBox.shrink();",
            "        },",
            "      ),",
            "    );",
            "  }",
            "}"
        ],
        "description": "EA: Generate a UI Page wrapped with BlocBuilder"
    }
}