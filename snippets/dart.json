    "EA Data Model (JSON)": {
        "prefix": "ea-model",
        "body": [
            "import '../../domain/entities/${2:feature_name}_entity.dart';",
            "",
            "class ${1:FeatureName}Model extends ${1:FeatureName}Entity {",
            "  const ${1:FeatureName}Model({required super.id});",
            "",
            "  factory ${1:FeatureName}Model.fromJson(Map<String, dynamic> json) {",
            "    return ${1:FeatureName}Model(",
            "      id: json['id'],",
            "    );",
            "  }",
            "",
            "  Map<String, dynamic> toJson() {",
            "    return {",
            "      'id': id,",
            "    };",
            "  }",
            "}"
        ],
        "description": "EA: Generate a Data Model with fromJson and toJson"
